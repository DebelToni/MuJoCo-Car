<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tank_car">
  <material name="platform_gray">
    <color rgba="0.42 0.44 0.48 1.0"/>
  </material>
  <material name="track_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="motor_blue">
    <color rgba="0.10 0.24 0.62 1.0"/>
  </material>
  <material name="free_wheel_silver">
    <color rgba="0.72 0.72 0.74 1.0"/>
  </material>

  <xacro:property name="body_len" value="0.10"/>
  <xacro:property name="body_wid" value="0.05"/>
  <xacro:property name="body_thk" value="0.02"/>
  <xacro:property name="lift" value="0.05"/>

  <xacro:property name="wheel_r" value="0.010"/>
  <xacro:property name="wheel_t" value="0.008"/>
  <xacro:property name="wheel_y" value="0.043"/>
  <xacro:property name="wheel_x" value="0.020"/>

  <xacro:property name="track_len" value="0.085"/>
  <xacro:property name="track_wid" value="0.012"/>
  <xacro:property name="track_thk" value="0.007"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${lift + body_thk/2}" rpy="0 0 0"/>
      <mass value="1.6"/>
      <inertia ixx="0.0034" ixy="0" ixz="0" iyy="0.0020" iyz="0" izz="0.0047"/>
    </inertial>

    <visual>
      <origin xyz="0 0 ${lift + body_thk/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_wid} ${body_len} ${body_thk}"/>
      </geometry>
      <material name="platform_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${lift + body_thk/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_wid} ${body_len} ${body_thk}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="${-wheel_x} 0 ${track_thk/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${track_wid} ${track_len} ${track_thk}"/>
      </geometry>
      <material name="track_black"/>
    </visual>
    <collision>
      <origin xyz="${-wheel_x} 0 ${track_thk/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${track_wid} ${track_len} ${track_thk}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="${wheel_x} 0 ${track_thk/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${track_wid} ${track_len} ${track_thk}"/>
      </geometry>
      <material name="track_black"/>
    </visual>
    <collision>
      <origin xyz="${wheel_x} 0 ${track_thk/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${track_wid} ${track_len} ${track_thk}"/>
      </geometry>
    </collision>
  </link>

  <xacro:macro name="wheel_link" params="name x y mat">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.08"/>
        <inertia ixx="0.000008" ixy="0" ixz="0" iyy="0.000004" iyz="0" izz="0.000008"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_t}"/>
        </geometry>
        <material name="${mat}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_t}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_r}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Motorized diagonal wheels: front-left and rear-right -->
  <xacro:wheel_link name="wheel_front_left_motor" x="${-wheel_x}" y="${wheel_y}" mat="motor_blue"/>
  <xacro:wheel_link name="wheel_rear_right_motor" x="${wheel_x}" y="${-wheel_y}" mat="motor_blue"/>

  <!-- Free wheels: front-right and rear-left -->
  <xacro:wheel_link name="wheel_front_right_free" x="${wheel_x}" y="${wheel_y}" mat="free_wheel_silver"/>
  <xacro:wheel_link name="wheel_rear_left_free" x="${-wheel_x}" y="${-wheel_y}" mat="free_wheel_silver"/>
</robot>
